# Image de production de l'API (22/10/2026) : sans les outils de test, sans rechargement automatique,
# utilisateur non-root. Utilisée par docker-compose.prod.yml, derrière Caddy (HTTPS).
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY pyproject.toml ./
COPY app/__init__.py ./app/__init__.py
RUN pip install --no-cache-dir -e .

COPY alembic.ini ./
COPY alembic ./alembic
COPY app ./app

RUN useradd --create-home --uid 10001 simtis && chown -R simtis /app
USER simtis

EXPOSE 8000
# Schéma à jour, données de référence, puis l'API. --proxy-headers : l'IP du client (journal d'audit)
# est lue dans l'en-tête de Caddy ; seul Caddy joint ce conteneur (aucun port publié).
CMD ["sh", "-c", "alembic upgrade head && python -m app.seeds && exec uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 2 --proxy-headers --forwarded-allow-ips='*'"]
