# Copiez ce fichier en `.env` pour changer une valeur.
# Sans `.env`, docker-compose.yml utilise ces mêmes valeurs par défaut (développement uniquement).

# --- Base de données (service `db`) ---
POSTGRES_USER=simtis
POSTGRES_PASSWORD=simtis_dev_password
POSTGRES_DB=simtis
# Port de PostgreSQL sur VOTRE poste (pour DBeaver, pgAdmin...). Changez-le s'il est déjà utilisé.
POSTGRES_HOST_PORT=5434
# Évitez les caractères spéciaux (@ : / %) dans le mot de passe : il est inséré dans l'URL de connexion.

# --- Backend (FastAPI) ---
APP_ENV=development
# Origines autorisées à appeler l'API depuis le navigateur, séparées par des virgules
CORS_ORIGINS=http://localhost:3000

# --- Frontend (Next.js) ---
# URL de l'API vue depuis le NAVIGATEUR (pas depuis le conteneur). Vide : même adresse que la page,
# port 8000 (http://localhost:8000/api sur ce PC).
NEXT_PUBLIC_API_URL=

# --- Accès depuis le réseau local (téléphone, autre PC), développement seulement ---
# 0.0.0.0 ouvre les ports 3000 et 8000 au réseau local ; 127.0.0.1 (défaut) : ce PC seulement.
# La base de données reste toujours fermée au réseau.
BIND_ADDRESS=127.0.0.1
# Origines du réseau local acceptées par l'API (motif), en plus de CORS_ORIGINS. Exemple :
# CORS_ORIGIN_REGEX=http://(192\.168|10)\.\d{1,3}\.\d{1,3}(\.\d{1,3})?:3000
CORS_ORIGIN_REGEX=
# IP de ce PC, séparées par des virgules (le serveur de développement Next.js refuse les autres)
ALLOWED_DEV_ORIGINS=

# --- Authentification ---
# Secret de signature des jetons. En PRODUCTION (APP_ENV=production) il est OBLIGATOIRE, d'au moins 32
# caractères aléatoires : l'application refuse de démarrer avec la valeur de développement.
# Générer : python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Durée de vie du jeton d'accès (minutes) et de la session (heures)
ACCESS_TOKEN_MINUTES=15
SESSION_HOURS=12
# Verrouillage du compte après N échecs de connexion consécutifs, pendant N minutes
MAX_LOGIN_FAILURES=5
LOCKOUT_MINUTES=15
